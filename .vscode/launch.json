{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug executable 'bitbetter'",
      "cargo": {
        "args": ["build"],
        "filter": {
          "name": "bitbetter",
          "kind": "bin"
        },
        "cwd": "${workspaceFolder}/src/bitbetter"
      },
      "args": [
        "-o",
        "/bitbetter/licensing.cer",
        "-n",
        "${workspaceFolder}/src/cert_gen/certs/bitbetter.cer",
        "-s",
        "${workspaceFolder}/bitwarden"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
